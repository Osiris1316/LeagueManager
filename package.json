{
  "name": "league-manager",
  "private": true,
  "scripts": {
    "dev:api": "cd packages/api && pnpm dev",
    "dev:web": "cd packages/web && pnpm dev",
    "dev": "concurrently \"pnpm dev:api\" \"pnpm dev:web\"",
    "build:web": "cd packages/web && pnpm build",
    "migrate": "npx wrangler d1 migrations apply league-manager-db --local",
    "seed": "node scripts/reset-local-db.mjs && pnpm migrate",
    "new:season": "npx tsx scripts/new-season.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy:api": "npx wrangler deploy",
    "deploy:web": "cd packages/web && pnpm build && npx wrangler pages deploy dist --project-name=league-manager"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.14.4"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26"
}
